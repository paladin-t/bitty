--[[
Example for the Bitty Engine

Copyright (C) 2020 - 2026 Tony Wang, all rights reserved

Homepage: https://paladin-t.github.io/bitty/
]]

local function log(objects, options, x, y, id)
	if options.variables[id] then
		return nil
	end

	local obj = Log.new(
		options.isBlocked,
		{
			id = id,
			variables = options.variables,
			score = 10,
			addScore = options.addScore,
			moveSpeed = 40,
			hurtInterval = 1,
			hurtSfx = options.hurtSfx
		}
	)
	obj.x = x
	obj.y = y
	table.insert(objects, 1, obj)

	return obj
end

local function guy(objects, options, x, y, id)
	if options.variables[id] then
		return nil
	end

	local obj = Guy.new(
		options.isBlocked,
		{
			id = id,
			variables = options.variables,
			score = 20,
			addScore = options.addScore,
			moveSpeed = 60,
			hurtInterval = 1,
			hurtSfx = options.hurtSfx
		}
	)
	obj.x = x
	obj.y = y
	table.insert(objects, 1, obj)

	return obj
end

local function rabbit(objects, options, x, y, id)
	if options.variables[id] then
		return nil
	end

	local obj = Rabbit.new(
		options.isBlocked,
		{
			id = id,
			variables = options.variables,
			score = 50,
			addScore = options.addScore,
			moveSpeed = 60,
			hurtInterval = 1,
			hurtSfx = options.hurtSfx,
			callback = options.rabbitKilled
		}
	)
	obj.x = x
	obj.y = y
	table.insert(objects, 1, obj)

	return obj
end

local function chest(objects, options, x, y, id)
	local obj = Chest.new(
		{
			id = id,
			variables = options.variables,
			hurtSfx = options.coinSfx,
			callback = options.equipSword
		}
	)
	obj.x = x
	obj.y = y
	table.insert(objects, 1, obj)

	return obj
end

local function coin(objects, options, x, y, id)
	if options.variables[id] then
		return nil
	end

	local obj = Coin.new(
		{
			id = id,
			variables = options.variables,
			vacuum = 'coin vacuum.spr',
			score = 50,
			addScore = options.addScore,
			hurtSfx = options.coinSfx
		}
	)
	obj.x = x
	obj.y = y
	table.insert(objects, 1, obj)

	return obj
end

local function heart(objects, options, x, y, id)
	if options.variables[id] then
		return nil
	end

	local obj = Heart.new(
		{
			id = id,
			variables = options.variables,
			vacuum = 'heart vacuum.spr',
			score = 20,
			addScore = options.addScore,
			hurtSfx = options.heartSfx
		}
	)
	obj.x = x
	obj.y = y
	table.insert(objects, 1, obj)

	return obj
end

local function portal(objects, options, x, y, dstZone, dstPos, sprite, box)
	local obj = Portal.new(
		{
			to = options.to,
			destination = dstZone,
			position = dstPos,
			sprite = sprite,
			box = box
		}
	)
	obj.x = x
	obj.y = y
	table.insert(objects, 1, obj)

	return obj
end

