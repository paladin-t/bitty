data:text/lua;count=608;path=utils.lua;
--[[
Example for the Bitty Engine

Copyright (C) 2020 - 2026 Tony Wang, all rights reserved

Homepage: https://paladin-t.github.io/bitty/
]]

function sign(val)
	if val < 0 then
		return -1
	elseif val > 0 then
		return 1
	end

	return 0
end

function clamp(val, min, max)
	if val < min then
		val = min
	elseif val > max then
		val = max
	end

	return val
end

function filter(list, pred)
	if not list then
		return nil
	end

	local result = { }
	for _, v in ipairs(list) do
		if pred and pred(v) then
			table.insert(result, v)
		elseif not pred and not v then
			return { }
		end
	end

	return result
end

data:text/lua;count=1898;path=characters/guy.lua;
--[[
Example for the Bitty Engine

Copyright (C) 2020 - 2026 Tony Wang, all rights reserved

Homepage: https://paladin-t.github.io/bitty/
]]

require 'character'

Guy = class({
	--[[ Variables. ]]

	_variables = nil,
	_id = 0,
	_triggered = false,

	--[[ Constructor. ]]

	ctor = function (self, isBlocked, options)
		local res = Resources.load('guy.spr')
		local box = Recti.byXYWH(10, 10, 12, 16)
		local boxAttack = Recti.byXYWH(10, 10, 12, 16)
		Character.ctor(self, res, nil, box, boxAttack, isBlocked, options)

		self.hp = 5

		self._variables = options.variables
		self._id = options.id
		self._triggered = self._variables[self._id]
		if self._triggered then
			self.hp = 0
		end
	end,

	--[[ Meta methods. ]]

	__tostring = function (self)
		return 'Guy'
	end,

	--[[ Methods. ]]

	behave = function (self, delta, hero)
		local canvasWidth, _ = Canvas.main:size()

		local diff = Vec2.new(hero.x - self.x, hero.y - self.y)
		if math.abs(diff.x) > canvasWidth * 0.5 then
			self:idle()
		else
			if math.abs(diff.y) > 4 then
				if diff.y < 0 then
					self:moveUp(delta)
				elseif diff.y > 0 then
					self:moveDown(delta)
				end
			end
			if math.abs(diff.x) > 4 then
				if diff.x < 0 then
					self:moveLeft(delta)
				elseif diff.x > 0 then
					self:moveRight(delta)
				end
			end
		end

		if hero:intersectsWithWeapon(self) then
			if self:hurt(hero.atk) then
				if self.hp <= 0 then
					self._variables[self._id] = true
					self._triggered = true
					self._addScore(self._score)
				end
			end
		elseif hero:intersects(self) then
			hero:hurt(self.atk)
		end

		local inter, fireball = hero:intersectsWithFireball(self)
		if inter and fireball then
			if self:hurt(fireball.atk) then
				if self.hp <= 0 then
					self._variables[self._id] = true
					self._triggered = true
					self._addScore(self._score)
				end
			end
			fireball:hurt(self.atk)
		end
	end
}, Character)

data:text/lua;count=2971;path=characters/hero.lua;
--[[
Example for the Bitty Engine

Copyright (C) 2020 - 2026 Tony Wang, all rights reserved

Homepage: https://paladin-t.github.io/bitty/
]]

require 'character'

Hero = class({
	--[[ Variables. ]]

	swordEquipped = false,

	_co = nil,
	_objects = nil,

	_fireballs = nil,
	_fireballMaxCount = 0,

	_spriteAttackWithSword = nil,

	_spriteFireball = nil,

	--[[ Constructor. ]]

	ctor = function (self, sprite, spriteAttack, box, boxAttack, isBlocked, options)
		Character.ctor(self, sprite, sprite, box, boxAttack, isBlocked, options)

		self.maxHp = options.hp
		self.hp = options.hp

		self._co = options.co
		self._objects = options.objects

		self._fireballs = { }
		self._fireballMaxCount = options.fireballMaxCount

		self._spriteAttackWithSword = spriteAttack

		self._spriteFireball = options.fireballSpr
	end,

	--[[ Meta methods. ]]

	__tostring = function (self)
		return 'Hero'
	end,

	--[[ Methods. ]]

	intersects = function (self, other)
		local inter = Math.intersects(self._aabb, other._aabb)

		return inter
	end,
	intersectsWithWeapon = function (self, other)
		local inter = Math.intersects(self._aabbAttack, other._aabb)

		return inter
	end,
	intersectsWithFireball = function (self, other)
		for _, v in ipairs(self._fireballs) do
			if Math.intersects(v._aabb, other._aabb) then
				return true, v
			end
		end

		return false, nil
	end,

	reset = function (self)
		self._fireballs = { }
	end,
	shoot = function (self)
		if self.hp < self.maxHp then
			return false
		end

		if #self._fireballs >= self._fireballMaxCount then
			return false
		end

		if self._hurting then
			return false
		end

		if self._shooting then
			return false
		end
		self._shooting = 0

		local moveSpeed = self._facing * 180
		local fireball = Fireball.new(
			self._spriteFireball,
			self._isBlocked,
			{
				co = self._co,
				objects = self._objects,
				direction = Vec2.new(self._facing.x, self._facing.y),
				moveSpeed = self._moveSpeed * 1.5
			}
		)
		if self._facing.x < 0 then
			fireball.x = self.x - self.box:width() * 0.5
			fireball.y = self.y
		elseif self._facing.x > 0 then
			fireball.x = self.x + self.box:width() * 0.5
			fireball.y = self.y
		end
		if self._facing.y < 0 then
			fireball.x = self.x
			fireball.y = self.y - self.box:height() * 0.5
		elseif self._facing.y > 0 then
			fireball.x = self.x
			fireball.y = self.y + self.box:height() * 0.5
		end
		table.insert(self._fireballs, fireball)

		return true
	end,

	equipSword = function (self)
		self.atk = 3

		self.swordEquipped = true

		self._spriteAttack = self._spriteAttackWithSword
	end,

	behave = function (self, delta, _1)
		if #self._fireballs > 0 then
			for _, v in ipairs(self._fireballs) do
				v:behave(delta, _1)
			end
			self._fireballs = filter(self._fireballs, function (obj) return obj.hp > 0 end)
		end
	end,

	update = function (self, delta)
		Character.update(self, delta)

		for _, v in ipairs(self._fireballs) do
			v:update(delta)
		end
	end
}, Character)

data:text/lua;count=1898;path=characters/log.lua;
--[[
Example for the Bitty Engine

Copyright (C) 2020 - 2026 Tony Wang, all rights reserved

Homepage: https://paladin-t.github.io/bitty/
]]

require 'character'

Log = class({
	--[[ Variables. ]]

	_variables = nil,
	_id = 0,
	_triggered = false,

	--[[ Constructor. ]]

	ctor = function (self, isBlocked, options)
		local res = Resources.load('log.spr')
		local box = Recti.byXYWH(10, 10, 12, 16)
		local boxAttack = Recti.byXYWH(10, 10, 12, 16)
		Character.ctor(self, res, nil, box, boxAttack, isBlocked, options)

		self.hp = 3

		self._variables = options.variables
		self._id = options.id
		self._triggered = self._variables[self._id]
		if self._triggered then
			self.hp = 0
		end
	end,

	--[[ Meta methods. ]]

	__tostring = function (self)
		return 'Log'
	end,

	--[[ Methods. ]]

	behave = function (self, delta, hero)
		local canvasWidth, _ = Canvas.main:size()

		local diff = Vec2.new(hero.x - self.x, hero.y - self.y)
		if math.abs(diff.x) > canvasWidth * 0.3 then
			self:idle()
		else
			if math.abs(diff.y) > 4 then
				if diff.y < 0 then
					self:moveUp(delta)
				elseif diff.y > 0 then
					self:moveDown(delta)
				end
			end
			if math.abs(diff.x) > 4 then
				if diff.x < 0 then
					self:moveLeft(delta)
				elseif diff.x > 0 then
					self:moveRight(delta)
				end
			end
		end

		if hero:intersectsWithWeapon(self) then
			if self:hurt(hero.atk) then
				if self.hp <= 0 then
					self._variables[self._id] = true
					self._triggered = true
					self._addScore(self._score)
				end
			end
		elseif hero:intersects(self) then
			hero:hurt(self.atk)
		end

		local inter, fireball = hero:intersectsWithFireball(self)
		if inter and fireball then
			if self:hurt(fireball.atk) then
				if self.hp <= 0 then
					self._variables[self._id] = true
					self._triggered = true
					self._addScore(self._score)
				end
			end
			fireball:hurt(self.atk)
		end
	end
}, Character)

data:text/lua;count=3088;path=characters/rabbit.lua;
--[[
Example for the Bitty Engine

Copyright (C) 2020 - 2026 Tony Wang, all rights reserved

Homepage: https://paladin-t.github.io/bitty/
]]

require 'character'

Rabbit = class({
	--[[ Variables. ]]

	_variables = nil,
	_id = 0,
	_triggered = false,
	_callback = nil,

	_co = nil,
	_jumping = nil,
	_offsetY = 0,

	--[[ Constructor. ]]

	ctor = function (self, isBlocked, options)
		local res = Resources.load('rabbit.spr')
		local box = Recti.byXYWH(10, 10, 12, 16)
		local boxAttack = Recti.byXYWH(10, 10, 12, 16)
		Character.ctor(self, res, nil, box, boxAttack, isBlocked, options)

		self.hp = 12

		self._variables = options.variables
		self._id = options.id
		self._triggered = self._variables[self._id]
		if self._triggered then
			self.hp = 0
			if options.callback then
				options.callback()
			end
		end
		self._callback = options.callback

		self._co = Coroutine.new()
		self._co:start(
			function ()
				local delta, hero = coroutine.yield()
				local jumpInterval = 0.8

				Coroutine.waitFor(1)

				while true do
					self._jumping = 0
					while self._jumping do
						local diff = Vec2.new(hero.x - self.x, hero.y - self.y)
						if math.abs(diff.y) > 4 then
							if diff.y < 0 then
								self:moveUp(delta)
							elseif diff.y > 0 then
								self:moveDown(delta)
							end
						end
						if math.abs(diff.x) > 4 then
							if diff.x < 0 then
								self:moveLeft(delta)
							elseif diff.x > 0 then
								self:moveRight(delta)
							end
						end

						self._jumping = self._jumping + delta
						local halfInterval = jumpInterval * 0.5
						if self._jumping <= halfInterval then
							self._offsetY = -(self._jumping / halfInterval) * 32
						else
							self._offsetY = -(1 - (self._jumping - halfInterval) / halfInterval) * 32
						end
						if self._jumping >= jumpInterval then
							self._jumping = nil
							self._offsetY = 0
						end
						delta, _ = coroutine.yield()
					end

					self:idle()

					Coroutine.waitFor(1)
				end
			end
		)
	end,

	--[[ Meta methods. ]]

	__tostring = function (self)
		return 'Rabbit'
	end,

	--[[ Methods. ]]

	behave = function (self, delta, hero)
		self._co:update(delta, hero)

		if hero:intersectsWithWeapon(self) and not self._jumping then
			if self:hurt(hero.atk) then
				if self.hp <= 0 then
					self._variables[self._id] = true
					self._triggered = true
					if self._callback then
						self._callback()
					end
					self._addScore(self._score)
				end
			end
		elseif hero:intersects(self) and not self._jumping then
			hero:hurt(self.atk)
		end

		local inter, fireball = hero:intersectsWithFireball(self)
		if inter and fireball and not self._jumping then
			if self:hurt(fireball.atk) then
				if self.hp <= 0 then
					self._variables[self._id] = true
					self._triggered = true
					if self._callback then
						self._callback()
					end
					self._addScore(self._score)
				end
			end
			fireball:hurt(self.atk)
		end
	end,

	update = function (self, delta)
		ellipse(self.x, self.y, 6, 3, true, Color.new(30, 30, 30, 200))

		Character.update(self, delta)
	end
}, Character)

