--[[
Example for the Bitty Engine

Copyright (C) 2020 - 2026 Tony Wang, all rights reserved

Homepage: https://paladin-t.github.io/bitty/
]]

require 'character'

Portal = class({
	--[[ Variables. ]]

	_to = nil,
	_destination = nil,
	_position = nil,

	--[[ Constructor. ]]

	ctor = function (self, options)
		local res = nil
		if options.sprite then
			res = Resources.load(options.sprite)
		end
		local box = Recti.byXYWH(0, 0, 16, 16)
		if options.box then
			box = options.box
		end
		Character.ctor(self, res, nil, box, nil, nil, options)

		self.hp = 1

		self._to = options.to
		self._destination = options.destination
		self._position = options.position
	end,

	--[[ Meta methods. ]]

	__tostring = function (self)
		return 'Portal'
	end,

	--[[ Methods. ]]

	behave = function (self, delta, hero)
		local inter = hero:intersects(self)
		if inter then
			if self:hurt(hero.atk) then
				if self.hp <= 0 then
					self._to(self._destination, self._position)
				end
			end
		end
	end
}, Character)

data:text/lua;count=810;path=objects/vacuum.lua;
--[[
Example for the Bitty Engine

Copyright (C) 2020 - 2026 Tony Wang, all rights reserved

Homepage: https://paladin-t.github.io/bitty/
]]

require 'object'

Vacuum = class({
	--[[ Constructor. ]]

	ctor = function (self, asset, box)
		if not asset then asset = 'vacuum.spr' end
		local res = Resources.load(asset)
		if not box then box = Recti.byXYWH(0, 0, 32, 32) end
		Object.ctor(self, res, box)

		self.hp = 1

		self:play(
			'idle',
			false, false,
			function ()
				self.hp = 0

				Resources.unload(self._sprite)
				self._sprite = nil
			end
		)
	end,

	--[[ Meta methods. ]]

	__tostring = function (self)
		return 'Vacuum'
	end,

	--[[ Methods. ]]

	behave = function (self, delta, _1)
		-- Do nothing.
	end,

	update = function (self, delta)
		Object.update(self, delta, true)
	end
}, Object)

