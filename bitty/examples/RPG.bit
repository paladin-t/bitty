data:text/lua;count=12955;path=main.lua;
--[[
Example for the Bitty Engine

Copyright (C) 2020 - 2026 Tony Wang, all rights reserved

Homepage: https://paladin-t.github.io/bitty/
]]

-- Usage:
--   press A or B on gamepad to attack or shoot (with full HP and sword equipped);
--   press Left, Right, Up, Down on gamepad to move.
-- Note:
--   gamepad for player 1 is binded to W, A, S, D and J, K on keyboard by
--   default, you can change this by clicking "File", "Preferences...", "Input".

require 'co'
require 'gamepad'
require 'keycode'

require 'utils'
require 'scenes'
require 'characters/hero'
require 'characters/log'
require 'characters/guy'
require 'characters/rabbit'
require 'objects/fireball'
require 'objects/chest'
require 'objects/coin'
require 'objects/heart'
require 'objects/vacuum'
require 'objects/portal'

--[[
Constant.
]]

DEBUG = false -- Enable to show collision boxes.

local WALKABLE_CEL = 79
local BORDER_CEL = -1

local MAX_HP = 3
local FIREBALL_MAX_COUNT = 2

local LAYER1_MAPS = {
	{ 'zone111.map', nil,           'zone131.map', nil           },
	{ 'zone211.map', nil,           'zone231.map', 'zone241.map' },
	{ 'zone311.map', 'zone321.map', 'zone331.map', nil           },
	{ nil,           nil,           'zone431.map', nil           }
}
local LAYER2_MAPS = {
	{ 'zone112.map', nil,           'zone132.map', nil           },
	{ 'zone212.map', nil,           'zone232.map', 'zone242.map' },
	{ 'zone312.map', 'zone322.map', 'zone332.map', nil           },
	{ nil,           nil,           'zone432.map', nil           }
}
local LAYER3_MAPS = {
	{ 'zone113.map', nil,           'zone133.map', nil           },
	{ 'zone213.map', nil,           'zone233.map', 'zone243.map' },
	{ 'zone313.map', 'zone323.map', 'zone333.map', nil           },
	{ nil,           nil,           'zone433.map', nil           }
}
local LAYER4_MAPS = {
	{ 'zone114.map', nil,           'zone134.map', nil           },
	{ 'zone214.map', nil,           'zone234.map', 'zone244.map' },
	{ 'zone314.map', 'zone324.map', 'zone334.map', nil           },
	{ nil,           nil,           'zone434.map', nil           }
}
local SCENES = {
	{ SCENE11, nil,     SCENE13, nil     },
	{ SCENE21, nil,     SCENE23, SCENE24 },
	{ SCENE31, SCENE32, SCENE33, nil     },
	{ nil,     nil,     SCENE43, nil     }
}
local DOMAINS = {
	{ 'Forest', nil,       'Village', nil       },
	{ 'Forest', nil,       'Village', 'Village' },
	{ 'Forest', 'Passage', 'Passage', nil       },
	{ nil,      nil,       'Passage', nil       }
}

local SAVE_FILE = Path.combine(Path.writableDirectory, 'rpg.txt')

--[[
Variables.
]]

local co = nil

local ttf = nil
local bmp8x8 = nil
local bgm = nil
local winSfx = nil
local loseSfx = nil
local attackSfx = nil
local hurtSfx = nil
local chestSfx = nil
local coinSfx = nil
local heartSfx = nil
local bank = nil
local heroSpr = nil
local heroSprAttack = nil
local fireballSpr = nil

local layers = nil
local scene = nil
local hero = nil
local objects = nil

local variables = nil
local zone = 24
local score = 0
local highscore = 0
local newHighscore = false
local cooldown = nil
local played = 0
local won = false
local gameOver = false
local mapTicks = 0
local domainName = nil
local domainTip = nil
local tipTicks = 0

local gamepadADown, gamepadBDown = false, false

--[[
Functions.
]]

-- Loads highscore from file.
local function loadHighscore()
	local result = 0
	local file = File.new()
	if file:open(SAVE_FILE, Stream.Read) then
		result = file:readLine()
		result = tonumber(result)
		file:close()
	end

	return result
end

-- Saves highscore to file.
local function saveHighscore(data)
	local file = File.new()
	if file:open(SAVE_FILE, Stream.Write) then
		file:writeLine(tostring(data))
		file:close()
	end
end

-- Adds a number of score.
local function addScore(num)
	score = score + num
	if score > highscore then
		highscore = score
		newHighscore = true
	end
end

-- Gets the index of the current zone.
local function getZoneIndex()
	local i, j = math.floor(zone / 10), zone % 10

	return i, j
end

-- Intro before level start.
local function intro()
	local ticks = 0
	local delta = 0

	local i, j = getZoneIndex()
	if domainName == DOMAINS[i][j] then
		return
	else
		domainName = DOMAINS[i][j]
		domainTip = domainName
	end

	while ticks < 1.5 do
		ticks = ticks + delta

		delta = coroutine.yield()
	end
	domainTip = nil
end

-- Removes all dead ones from the objects collection.
local function removeDeadObjects()
	local dead = nil
	for i = #objects, 1, -1 do
		local obj = objects[i]
		if obj.hp <= 0 then
			if dead == nil then
				dead = { }
			end
			table.insert(dead, i)

			print(tostring(obj) .. ' removed.')
		end
	end

	if dead then
		for _, idx in ipairs(dead) do
			local obj = objects[idx]
			if not is(obj, Vacuum) and not is(obj, Portal) then
				local asset = nil
				if obj.vacuum then
					asset = obj.vacuum
				end
				local vacuum = Vacuum.new(asset)
				vacuum.x = obj.x
				vacuum.y = obj.y + (vacuum.box:height() - obj.box:height()) * 0.5
				table.insert(objects, vacuum)
			end

			table.remove(objects, idx)
		end
	end
end

-- Checks whether it's blocked on map at a specific position.
local function isBlocked(pos)
	if not layers[3] then
		return false
	end

	local cel = mget(layers[3], pos.x, pos.y)

	return cel ~= WALKABLE_CEL or cel == BORDER_CEL
end

-- Starts a new game.
local function start(toGame, pos)
	print('Start zone: ' .. tostring(zone) .. '.')

	for i = 1, #layers do
		if layers[i] then
			Resources.unload(layers[i])
		end
	end
	local i, j = getZoneIndex()
	layers[1] = LAYER1_MAPS[i][j] and Resources.load(LAYER1_MAPS[i][j]) or nil
	layers[2] = LAYER2_MAPS[i][j] and Resources.load(LAYER2_MAPS[i][j]) or nil
	layers[3] = LAYER3_MAPS[i][j] and Resources.load(LAYER3_MAPS[i][j]) or nil
	layers[4] = LAYER4_MAPS[i][j] and Resources.load(LAYER4_MAPS[i][j]) or nil
	scene = SCENES[i][j]

	if not hero or won or gameOver then
		objects = { }
		hero = Hero.new(
			heroSpr, heroSprAttack,
			Recti.byXYWH(2, 12, 12, 14), Recti.byXYWH(0, 0, 12, 12),
			isBlocked,
			{
				co = co,
				objects = objects,
				hp = MAX_HP,
				moveSpeed = 100,
				attackInterval = 0.5,
				shootInterval = 0.5,
				fireballSpr = fireballSpr,
				fireballMaxCount = FIREBALL_MAX_COUNT,
				hurtInterval = 1,
				hurtSfx = hurtSfx
			}
		)
	else
		while #objects > 0 do
			table.remove(objects)
		end
	end
	hero.x = pos.x
	hero.y = pos.y
	hero:reset()
	if not objects then
		objects = { }
	end
	table.insert(objects, hero)

	if won or gameOver then
		variables = { }
		score = 0
		newHighscore = false
		won = false
		gameOver = false

		play(bgm, true, 2)
	end
	mapTicks = 0
	domainTip = nil
	tipTicks = 0

	gamepadADown, gamepadBDown = false, false

	if toGame then
		co:start(
			scene,
			objects,
			{
				co = co,
				objects = objects,
				variables = variables,
				addScore = addScore,
				to = function (dst, pos)
					zone = dst

					start(true, pos)
				end,
				isBlocked = isBlocked,
				hurtSfx = hurtSfx,
				chestSfx = chestSfx,
				coinSfx = coinSfx,
				heartSfx = heartSfx,
				equipSword = function ()
					hero:equipSword()
				end,
				rabbitKilled = function ()
					won = true
					co:clear()

					play(winSfx)
				end
			}
		)

		co:start(intro)
	end

	collectgarbage()
	Resources.collect()
end

-- Draws the HUD.
local function hud(delta)
	local canvasWidth, canvasHeight = Canvas.main:size()

	tex(bank, 10, 8, 32, 32, 480, 384, 32, 32)
	tex(bank, 18, 16, 16, 16, 560, 352, 16, 16)
	for i = 1, MAX_HP do
		local full = hero and hero.hp >= i
		tex(bank, 32 + 16 * i, 8, 16, 16, full and 480 or 544, 320, 16, 16)
	end

	mapTicks = mapTicks + delta
	if mapTicks >= 0.8 then
		mapTicks = mapTicks - 0.8
	end
	for j = 1, 4 do
		for i = 1, 4 do
			if LAYER1_MAPS[i][j] then
				local i_, j_ = getZoneIndex()
				local fill = i == i_ and j == j_ and mapTicks < 0.4

				rect(
					128 + (i - 1) * 8, 10 + (j - 1) * 8,
					128 + i * 8, 10 + j * 8,
					fill
				)
			end
		end
	end

	if hero.swordEquipped then
		tex(bank, 49, 26, 16, 16, 544, 368, 16, 16)
	end

	font(bmp8x8)
	local txt = 'HIGHSCORE'
	local textWidth, textHeight = measure(txt, bmp8x8)
	text(txt, 470 - textWidth + 1, 9, Color.new(0, 0, 0))
	text(txt, 470 - textWidth, 8, Color.new(200, 220, 210))
	txt = highscore
	textWidth, _ = measure(txt, bmp8x8)
	text(txt, 470 - textWidth + 1, 19, Color.new(0, 0, 0))
	text(txt, 470 - textWidth, 18, newHighscore and Color.new(255, 100, 100) or Color.new(200, 220, 210))
	txt = 'SCORE'
	textWidth, _ = measure(txt, bmp8x8)
	text(txt, 470 - textWidth + 1, 29, Color.new(0, 0, 0))
	text(txt, 470 - textWidth, 28, Color.new(200, 220, 210))
	txt = score
	textWidth, _ = measure(txt, bmp8x8)
	text(txt, 470 - textWidth + 1, 39, Color.new(0, 0, 0))
	text(txt, 470 - textWidth, 38, Color.new(200, 220, 210))

	if played == 0 or won or gameOver then
		font(ttf)
		if won then
			text('YOU', 176, 143, Color.new(0, 0, 0))
			text('YOU', 173, 140)
			text('WIN', 253, 143, Color.new(0, 0, 0))
			text('WIN', 256, 140)
		elseif gameOver then
			text('GAME', 166, 143, Color.new(0, 0, 0))
			text('GAME', 163, 140)
			text('OVER', 249, 143, Color.new(0, 0, 0))
			text('OVER', 252, 140)
		else
			text('BITTY', 168, 143, Color.new(0, 0, 0))
			text('BITTY', 165, 140)
			text('RPG', 265, 143, Color.new(0, 0, 0))
			text('RPG', 268, 140)
		end

		font(bmp8x8)
		tipTicks = tipTicks + delta
		if tipTicks >= 0.8 then
			tipTicks = tipTicks - 0.8
		end
		if tipTicks < 0.4 then
			if played == 0 then
				txt = 'Press ENTER to start'
				textWidth, _ = measure(txt, bmp8x8)
				text(txt, (canvasWidth - textWidth) * 0.5 + 1, 261, Color.new(0, 0, 0))
				text(txt, (canvasWidth - textWidth) * 0.5, 260)
			else
				txt = 'Press ENTER to restart'
				textWidth, _ = measure(txt, bmp8x8)
				text(txt, (canvasWidth - textWidth) * 0.5 + 1, 261, Color.new(0, 0, 0))
				text(txt, (canvasWidth - textWidth) * 0.5, 260)
			end
		end
		if keyp(KeyCode.Return) or keyp(KeyCode.KeypadEnter) then -- Return/Enter key on either the main section or numpad.
			zone = 24
			cooldown = 2
			played = played + 1
			saveHighscore(highscore)
			start(true, Vec2.new(240, 211))
		end
	end

	if domainTip ~= nil then
		font(ttf)
		textWidth, textHeight = measure(domainTip, ttf)
		text(domainTip, (canvasWidth - textWidth) * 0.5 + 3, (canvasHeight - textHeight) * 0.5 + 3, Color.new(0, 0, 0))
		text(domainTip, (canvasWidth - textWidth) * 0.5, (canvasHeight - textHeight) * 0.5)
	end
end

function quit()
	saveHighscore(highscore)
end

function setup()
	co = Coroutine.new()

	ttf = Font.new('college.ttf', 30)
	bmp8x8 = Font.new('ascii 8x8.png', Vec2.new(8, 8))

	bgm = Resources.load('bgm.ogg', Music)
	winSfx = Resources.load('win.mp3', Sfx)
	loseSfx = Resources.load('lose.mp3', Sfx)
	attackSfx = Resources.load('attack.wav', Sfx)
	hurtSfx = Resources.load('hurt.wav', Sfx)
	coinSfx = Resources.load('coin.wav', Sfx)
	heartSfx = Resources.load('heart.wav', Sfx)
	chestSfx = coinSfx
	volume(1, 0.5)
	play(bgm, true, 2)

	bank = Resources.load('bank.png')
	heroSpr = Resources.load('hero.spr')
	heroSprAttack = Resources.load('hero attack.spr')
	fireballSpr = Resources.load('fireball.spr')

	layers = { nil, nil, nil, nil }

	variables = { }
	highscore = loadHighscore()

	start(false, Vec2.new(240, 211))
end

function update(delta)
	-- Prevent penetrating.
	delta = math.min(delta, 0.02)

	-- Update coroutines.
	co:update(delta)

	-- Game logic.
	if played > 0 and not won and not gameOver then
		if btn(Gamepad.Up) then
			hero:moveUp(delta)
		elseif btn(Gamepad.Down) then
			hero:moveDown(delta)
		end
		if btn(Gamepad.Right) then
			hero:moveRight(delta)
		elseif btn(Gamepad.Left) then
			hero:moveLeft(delta)
		end
		if cooldown then
			cooldown = cooldown - delta
			if cooldown <= 0 then
				cooldown = nil
			end
		else
			if btn(Gamepad.A) then
				if not gamepadADown then
					gamepadADown = true

					if hero:attack() then
						if hero.swordEquipped and hero.hp >= MAX_HP then
							hero:shoot()
						end

						play(attackSfx)
					end
				end
			else
				gamepadADown = false
			end
			if btn(Gamepad.B) then
				if not gamepadBDown then
					gamepadBDown = true

					if hero:attack() then
						if hero.swordEquipped and hero.hp >= MAX_HP then
							hero:shoot()
						end

						play(attackSfx)
					end
				end
			else
				gamepadBDown = false
			end
		end
		if not btn() then
			hero:idle()
		end

		if hero.hp <= 0 then
			gameOver = true
			co:clear()

			play(loseSfx)
		end
	end

	-- Update objects and draw everything.
	camera(0, -48)
	map(layers[1])
	if layers[2] then
		map(layers[2])
	end
	if layers[3] then
		map(layers[3])
	end
	if not won and not gameOver then
		for _, v in ipairs(objects) do
			v:behave(delta, hero)
		end
	end
	for _, v in ipairs(objects) do
		v:update(delta)
	end
	if layers[4] then
		map(layers[4])
	end
	removeDeadObjects()
	camera()

	table.sort(
		objects,
		function (left, right)
			local y1 = left.y
			local y2 = right.y

			return y1 < y2
		end
	)

	hud(delta)
end

