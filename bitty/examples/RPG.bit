--[[
Example for the Bitty Engine

Copyright (C) 2020 - 2026 Tony Wang, all rights reserved

Homepage: https://paladin-t.github.io/bitty/
]]

require 'object'

Character = class({
	--[[ Variables. ]]

	vacuum = nil,

	boxAttack = nil,

	_aabbAttack = nil,

	_moveSpeed = 0,
	_attackInterval = 0,
	_shootInterval = 0,
	_hurtInterval = 0,

	_moving = nil,
	_facing = nil,
	_attacking = nil,
	_shooting = nil,
	_hurting = nil,

	_spriteNormal = nil,
	_spriteAttack = nil,

	_walker = nil,
	_isBlocked = nil,
	_slidable = 5,

	_score = 0,
	_addScore = nil,

	_hurtSfx = nil,

	--[[ Constructor. ]]

	ctor = function (self, sprite, spriteAttack, box, boxAttack, isBlocked, options)
		Object.ctor(self, sprite, box)

		self.vacuum = options.vacuum

		self.boxAttack = boxAttack

		self._moveSpeed = options.moveSpeed
		self._attackInterval = options.attackInterval
		self._shootInterval = options.shootInterval
		self._hurtInterval = options.hurtInterval

		self._moving = Vec2.new(0, 0)
		self._facing = Vec2.new(0, 1)
		self._shooting = 0

		self._spriteNormal = sprite
		self._spriteAttack = spriteAttack

		if isBlocked then
			self._walker = Walker.new()
			self._walker.objectSize = Vec2.new(self.box:width(), self.box:height())
			self._walker.offset = Vec2.new(self.box:width() * 0.5, self.box:height())
			self._isBlocked = isBlocked
		end

		self._score = options.score
		self._addScore = options.addScore

		self._hurtSfx = options.hurtSfx
	end,

	--[[ Meta methods. ]]

	__tostring = function (self)
		return 'Character'
	end,

	--[[ Methods. ]]

	idle = function (self)
		if self._attacking then
			return
		end

		if self._shooting then
			return
		end

		if self._hurting then
			return
		end

		self:_switch(self._spriteNormal)

		if self._facing.x == 0 and self._facing.y == 0 then
			self:play('idle', false)
		else
			if self._facing.x == -1 then
				self:play('idle left', false)
			elseif self._facing.x == 1 then
				self:play('idle right', false)
			end
			if self._facing.y == -1 then
				self:play('idle up', false)
			elseif self._facing.y == 1 then
				self:play('idle down', false)
			end
		end
	end,
	moveLeft = function (self, delta)
		self._facing = Vec2.new(-1, 0)
		if not self._attacking then
			self:_switch(self._spriteNormal)

			self:play('move left', false)
		end

		local moved = self:_move(-delta * self._moveSpeed, 0)
		self._moving.x = self._moving.x + moved.x
		self._moving.y = self._moving.y + moved.y

		return moved
	end,
	moveRight = function (self, delta)
		self._facing = Vec2.new(1, 0)
		if not self._attacking then
			self:_switch(self._spriteNormal)

			self:play('move right', false)
		end

		local moved = self:_move(delta * self._moveSpeed, 0)
		self._moving.x = self._moving.x + moved.x
		self._moving.y = self._moving.y + moved.y

		return moved
	end,
	moveUp = function (self, delta)
		self._facing = Vec2.new(0, -1)
		if not self._attacking then
			self:_switch(self._spriteNormal)

			self:play('move up', false)
		end

		local moved = self:_move(0, -delta * self._moveSpeed)
		self._moving.x = self._moving.x + moved.x
		self._moving.y = self._moving.y + moved.y

		return moved
	end,
	moveDown = function (self, delta)
		self._facing = Vec2.new(0, 1)
		if not self._attacking then
			self:_switch(self._spriteNormal)

			self:play('move down', false)
		end

		local moved = self:_move(0, delta * self._moveSpeed)
		self._moving.x = self._moving.x + moved.x
		self._moving.y = self._moving.y + moved.y

		return moved
	end,
	attack = function (self)
		if self._hurting then
			return false
		end

		if self._attacking then
			return false
		end
		self._attacking = 0

		self:_switch(self._spriteAttack)

		if self._facing.x == -1 then
			self:play(
				'attack left', true, false,
				function ()
					self:idle()
				end
			)
		elseif self._facing.x == 1 then
			self:play(
				'attack right', true, false,
				function ()
					self:idle()
				end
			)
		end
		if self._facing.y == -1 then
			self:play(
				'attack up', true, false,
				function ()
					self:idle()
				end
			)
		elseif self._facing.y == 1 then
			self:play(
				'attack down', true, false,
				function ()
					self:idle()
				end
			)
		end

		return true
	end,
	shoot = function (self)
		if self._hurting then
			return false
		end

		if self._shooting then
			return false
		end
		self._shooting = 0

		self:_switch(self._spriteNormal)

		self:play(
			'shoot', false, false,
			function ()
				self:idle()
			end
		)

		return true
	end,
	heal = function (self, points)
		local hp = self.hp
		self.hp = self.hp + points
		if self.maxHp > 0 and self.hp > self.maxHp then
			self.hp = self.maxHp
		end

		return self.hp > hp
	end,
	hurt = function (self, atk)
		if self._hurting then
			return false
		end
		self._hurting = 0

		if self.hp <= 0 then
			return false
		end

		self:_switch(self._spriteNormal)

		self:play(
			'hurt', false, false,
			function ()
				self:idle()
			end
		)

		self.hp = self.hp - atk
		if self.hp < 0 then
			self.hp = 0
		end

		if self._hurtSfx then
			play(self._hurtSfx)
		end

		return true
	end,

	update = function (self, delta)
		local visible = true
		if self._attacking then
			self._attacking = self._attacking + delta
			if self._attacking >= self._attackInterval then
				self._attacking = nil
			end
		end
		if self._shooting then
			self._shooting = self._shooting + delta
			if self._shooting >= self._shootInterval then
				self._shooting = nil
			end
		end
		if self._hurting then
			self._hurting = self._hurting + delta
			if self._hurting >= self._hurtInterval then
				self._hurting = nil
			else
				visible = self._hurting % 0.3 < 0.15
			end
		end

		if self._attacking then
			local dstX, dstY = 0, 0
			if self._facing.x == -1 then
				dstX = self.x - self.box:width() * 0.5 - self.boxAttack:width() - 2
				dstY = self.y - self.box:height() * 0.5 - self.boxAttack:height() * 0.5
			elseif self._facing.x == 1 then
				dstX = self.x + self.box:width() * 0.5 + 2
				dstY = self.y - self.box:height() * 0.5 - self.boxAttack:height() * 0.5
			end
			if self._facing.y == -1 then
				dstX = self.x - self.boxAttack:width() * 0.5
				dstY = self.y - self.box:height() - self.boxAttack:height() - 2
			elseif self._facing.y == 1 then
				dstX = self.x - self.boxAttack:width() * 0.5
				dstY = self.y + 2
			end
			self._aabbAttack = Recti.new(
				dstX + self.boxAttack:xMin(), dstY + self.boxAttack:yMin(),
				dstX + self.boxAttack:xMax(), dstY + self.boxAttack:yMax()
			)
		else
			self._aabbAttack = nil
		end

		local l = self._moving.length
		if l ~= 0 then
			if l > delta * self._moveSpeed then
				self._moving = self._moving * (delta * self._moveSpeed / l)
			end
			self.x = self.x + self._moving.x
			self.y = self.y + self._moving.y
			self._moving = Vec2.new(0, 0)
		end

		Object.update(self, delta, visible)

		if DEBUG then
			if self._aabbAttack then
				rect(
					self._aabbAttack:xMin(), self._aabbAttack:yMin(),
					self._aabbAttack:xMax(), self._aabbAttack:yMax(),
					false,
					Color.new(0, 0, 255)
				)
			end
		end
	end,

	_move = function (self, dx, dy)
		local newDir = self._walker:solve(
			Vec2.new(self.x, self.y), Vec2.new(dx, dy),
			self._isBlocked,
			self._slidable
		)

		return newDir
	end,

	_switch = function (self, sprite)
		if self._sprite == sprite then
			return
		end

		self._sprite = sprite

		self._spriteWidth = self._sprite.width
		self._spriteHeight = self._sprite.height
	end
}, Object)

