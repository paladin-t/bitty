--[[
Example for the Bitty Engine

Copyright (C) 2020 - 2026 Tony Wang, all rights reserved

Homepage: https://paladin-t.github.io/bitty/
]]

require 'character'

Heart = class({
	--[[ Variables. ]]

	_variables = nil,
	_id = 0,
	_triggered = false,

	--[[ Constructor. ]]

	ctor = function (self, options)
		local res = Resources.load('heart.spr')
		local box = Recti.byXYWH(0, 0, 16, 16)
		Character.ctor(self, res, nil, box, nil, nil, options)

		self.hp = 1

		self._variables = options.variables
		self._id = options.id
		self._triggered = self._variables[self._id]
		if self._triggered then
			self.hp = 0
		end
	end,

	--[[ Meta methods. ]]

	__tostring = function (self)
		return 'Heart'
	end,

	--[[ Methods. ]]

	behave = function (self, delta, hero)
		if self._triggered then
			return
		end

		local inter = hero:intersects(self)
		if inter then
			if self:hurt(hero.atk) then
				if self.hp <= 0 then
					self._variables[self._id] = true
					self._triggered = true
					hero:heal(1)
				end
			end
		end
	end
}, Character)

