--[[
Example for the Bitty Engine

Copyright (C) 2020 - 2026 Tony Wang, all rights reserved

Homepage: https://paladin-t.github.io/bitty/
]]

require 'character'

Chest = class({
	--[[ Variables. ]]

	_variables = nil,
	_id = 0,
	_triggered = false,
	_callback = nil,

	--[[ Constructor. ]]

	ctor = function (self, options)
		local res = Resources.load('chest.spr')
		local box = Recti.byXYWH(6, 9, 20, 14)
		Character.ctor(self, res, nil, box, nil, nil, options)

		self.hp = 1

		self._variables = options.variables
		self._id = options.id
		self._triggered = self._variables[self._id]
		if self._triggered then
			self:play('opened')
		end
		self._callback = options.callback
	end,

	--[[ Meta methods. ]]

	__tostring = function (self)
		return 'Chest'
	end,

	--[[ Methods. ]]

	behave = function (self, delta, hero)
		if self._triggered then
			return
		end

		local inter = hero:intersectsWithWeapon(self)
		if inter then
			self._variables[self._id] = true
			self._triggered = true
			self:play('open', true, false)
			if self._callback then
				self._callback()
			end
		end
	end
}, Character)

