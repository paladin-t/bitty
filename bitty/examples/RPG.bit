data:text/lua;count=1552;path=objects/fireball.lua;
--[[
Example for the Bitty Engine

Copyright (C) 2020 - 2026 Tony Wang, all rights reserved

Homepage: https://paladin-t.github.io/bitty/
]]

require 'character'

Fireball = class({
	--[[ Variables. ]]

	_co = nil,
	_objects = nil,

	_direction = nil,

	_lifetime = 1,
	_ticks = 0,

	--[[ Constructor. ]]

	ctor = function (self, sprite, isBlocked, options)
		Character.ctor(self, sprite, nil, Recti.byXYWH(1, 1, 14, 14), nil, isBlocked, options)

		self._co = options.co
		self._objects = options.objects

		self.hp = 1
		self.atk = 2

		self._direction = options.direction

		self._lifetime = options.lifetime or 1

		self._slidable = 0
	end,

	--[[ Meta methods. ]]

	__tostring = function (self)
		return 'Fireball'
	end,

	--[[ Methods. ]]

	behave = function (self, delta, _1)
		self._ticks = self._ticks + delta
		if self._ticks >= self._lifetime then
			self.hp = 0

			self:_vanish()

			return
		end

		local forward = self:_move(
			delta * self._moveSpeed * sign(self._direction.x),
			delta * self._moveSpeed * sign(self._direction.y)
		)
		if forward.x == 0 and forward.y == 0 then
			self.hp = 0

			self:_vanish()
		else
			self._moving.x = self._moving.x + forward.x
			self._moving.y = self._moving.y + forward.y
		end
	end,

	_vanish = function (self)
		self._co:start(
			function ()
				local vacuum = Vacuum.new('fireball vacuum.spr', Recti.byXYWH(0, 0, 16, 16))
				vacuum.x = self.x
				vacuum.y = self.y + (vacuum.box:height() - self.box:height()) * 0.5
				table.insert(self._objects, 1, vacuum)
			end
		)
	end
}, Character)

